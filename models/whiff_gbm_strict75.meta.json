{
  "model": "HistGradientBoostingClassifier pipeline (ColumnTransformer + HGB)",
  "max_iter": 75,
  "learning_rate": 0.06,
  "early_stopping": false,
  "random_state": 42,
  "target": "strict whiff (swinging_strike, swinging_strike_blocked only; foul_tip excluded)",
